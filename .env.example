# Server Network Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=false
CORS_ORIGINS="http://localhost:3000"

# Database Connection Strings (Choose one):
# ------------------------------------------------------------------------------
# 1. Local SQLite (Default for offline lab verification):
DATABASE_URL="file:./dev.db"

# 2. Local Docker PostgreSQL (docker-compose up):
# DATABASE_URL="postgresql://lazarus_admin:lazarus_secret_2026@localhost:5432/lazarus_forensics?schema=public"

# 3. Cloud Database (+1 Bonus Mark - Supabase / Railway / Aiven):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cryptographic Master Key (AES-256-GCM Case Salt Envelope Encryption)
# 64-character hexadecimal key (zero secrets committed to version control)
PROVENANCE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY

# Optional Custom Domain (+1 Bonus Mark - DuckDNS / Custom FQDN)
CUSTOM_DOMAIN=lazarus-forensics.duckdns.org
