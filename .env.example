# ==============================================================================
# LAZARUS-X ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: LAZARUS-X Forensic Relational Reconstruction
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Evaluation User Seeding:
# Set to true to automatically seed evaluation accounts (investigator@lazarus.local / admin@lazarus.local).
# In production, set to false and provision operators explicitly via `npm run admin:provision`.
SEED_DEFAULT_USERS=true

# Database Connection Strings (Choose one):
# ------------------------------------------------------------------------------
# 1. Local SQLite (Default for offline lab verification):
DATABASE_URL="file:./dev.db"

# Prisma schema currently supports SQLite. PostgreSQL requires a schema/provider migration.

# Cryptographic Master Key (AES-256-GCM Case Salt Envelope Encryption)
# Generate a random 32-byte key locally and paste the 64-character hex value here.
PROVENANCE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_KEY

# Optional Custom Domain (+1 Bonus Mark - DuckDNS / Custom FQDN)
# Set only after you have registered/configured a domain.
CUSTOM_DOMAIN=

# Optional; required to expose metrics in production (use >=32 random characters).
METRICS_TOKEN=
